# Local full-CV runtime. Do not commit the populated .env file.
ROBOFLOW_API_KEY=replace_me

# Runtime mode: live hides post-game UI/routes from the normal operator flow.
RTGS_MODE=live
RTGS_ARTIFACT_POLICY=compact

# Runtime storage. Compact post-game runs keep reports + observations and
# remove source/proxy/annotated video after successful report persistence.
RTGS_DATA_DIR=/workspace/realtimegamestatistics/data

ANALYSIS_HZ=10
KEYPOINT_HZ=2
PROGRESS_HZ=2
RTGS_CORS_ORIGINS=*

# Live inference and diagnostics.
PROCESS_EVERY=3
INFER_SCALE=0.5
CONFIDENCE=0.3
RTGS_EVENT_CLIPS=1

# Cloud lifecycle settings are preferably entered with `./rtgs cloud configure`
# and stored with mode 0600 outside the repository. Environment overrides:
# RUNPOD_API_KEY=
# RUNPOD_NETWORK_VOLUME_ID=
# RUNPOD_CONTAINER_REGISTRY_AUTH_ID=
# RTGS_GPU_IMAGE=ghcr.io/elleowo/realtimegamestatistics:{sha}
# RTGS_RELAY_PUBLISH_URL=rtmps://relay.example.com:1936/live?user=publisher&pass=...
# RTGS_RELAY_READ_URL=rtmps://relay.example.com:1936/live?user=reader&pass=...
