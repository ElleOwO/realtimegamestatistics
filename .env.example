# ============================================================================
# Environment Variables Template
# Copy to .env and fill in your values before running docker-compose
# ============================================================================

# ── API Keys ────────────────────────────────────────────────────────────
# Get from https://roboflow.com — your Roboflow workspace settings
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# ── GCP / Vertex AI (for Gemini AI insights) ───────────────────────────
# Replace with your GCP project ID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Set to true only when you want Gemini tactical narratives
ENABLE_GEMINI=false

# ── Video Source Configuration ──────────────────────────────────────────
# Options: "webcam" (default, for testing) or "rtsp" (Veo camera via MediaMTX)
VIDEO_SOURCE=webcam
WEBCAM_INDEX=0
RTSP_URL=rtsp://mediamtx:8554/live

# ── Model IDs (Update after fine-tuning on Roboflow) ──────────────────
# Format: "workspace/project/version"
PLAYER_MODEL_ID=spen-rtgs-oc4ez/4
FIELD_MODEL_ID=football-field-detection-f07vi/14

# ── xG Model ────────────────────────────────────────────────────────────
# Path to your trained XGBoost model (relative to /app or absolute)
XG_MODEL_PATH=xg_model_womens.ubj

# ── Redis Configuration (optional, for multi-client pub/sub) ───────────
REDIS_URL=redis://redis:6379

# ── Frontend WebSocket URL ──────────────────────────────────────────────
# Local dev: ws://localhost:8000/ws
# Production: wss://api.yourdomain.com/ws (with TLS reverse proxy)
VITE_WS_URL=ws://localhost:8000/ws
